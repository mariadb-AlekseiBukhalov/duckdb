# name: test/sql/aggregate/aggregates/limited_aggregate_limit.test
# description: GROUP BY with aggregates and LIMIT without ORDER BY returns exact aggregates for every returned group
# group: [aggregates]

statement ok
PRAGMA threads=4

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

statement ok
CREATE TABLE t AS SELECT
  CASE WHEN i % 97 = 0 THEN NULL ELSE (hash(i) % 20000)::BIGINT END AS a,
  CASE WHEN i % 53 = 0 THEN NULL ELSE 'p' || (hash(i * 7) % 40)::VARCHAR END AS b,
  (i % 1000)::INTEGER AS c,
  i::BIGINT AS v
FROM range(400000) t(i)

statement ok
CREATE TABLE t_few AS SELECT (i % 7)::INTEGER AS a, 'x' AS b, (i % 10)::INTEGER AS c, i::BIGINT AS v FROM range(100000) t(i)

statement ok
CREATE TABLE t_null_key AS SELECT NULL::INTEGER AS a, 'x' AS b, 1 AS c, i::BIGINT AS v FROM range(50000) t(i)

statement ok
CREATE TABLE t_neg AS SELECT ((hash(i) % 200000)::BIGINT - 100000) AS a, (i % 7)::INTEGER AS b, 1 AS c, i::BIGINT AS v FROM range(300000) t(i)

query II
EXPLAIN SELECT a, b, count(*) AS n, sum(v) AS s FROM t GROUP BY a, b LIMIT 10
----
physical_plan	<REGEX>:.*LIMITED_DISTINCT.*

query II
EXPLAIN SELECT a, b, count(*) AS n, sum(v) AS s FROM t GROUP BY a, b ORDER BY a LIMIT 10
----
physical_plan	<REGEX>:.*TOP_N.*

statement ok
