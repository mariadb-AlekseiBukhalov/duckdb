statement ok
CREATE TYPE mood AS ENUM ('m00','m01','m02','m03','m04','m05','m06','m07','m08','m09','m10','m11','m12','m13','m14','m15','m16','m17','m18','m19','m20','m21','m22','m23','m24','m25','m26','m27','m28','m29')

statement ok
CREATE TABLE tt AS SELECT
  i::BIGINT AS v,
  (i % 1000)::INTEGER AS c,
  CASE WHEN i % 31 = 0 THEN NULL ELSE DATE '2020-01-01' + (i % 40)::INTEGER END AS d,
  CASE WHEN i % 31 = 0 THEN NULL ELSE TIMESTAMP '2020-01-01 00:00:00' + to_hours(i % 40) END AS ts,
  CASE WHEN i % 31 = 0 THEN NULL ELSE (18446744073709551615::UBIGINT - (i % 40)::UBIGINT * 1000003::UBIGINT) END AS u_high,
  CASE WHEN i % 31 = 0 THEN NULL ELSE (9223372036854775808::UBIGINT + (i % 40)::UBIGINT) END AS u_mid,
  CASE WHEN i % 31 = 0 THEN NULL ELSE ((i % 40) - 20)::DECIMAL(12,2) END AS dec,
  CASE WHEN i % 31 = 0 THEN NULL ELSE (i % 40) % 2 = 0 END AS bo,
  CASE WHEN i % 31 = 0 THEN NULL ELSE ('m' || lpad((i % 30)::VARCHAR, 2, '0'))::mood END AS en,
  CASE WHEN i % 31 = 0 THEN NULL ELSE (((i % 40) - 20) * 100000)::INTEGER END AS neg,
  CASE WHEN i % 31 = 0 THEN NULL ELSE ((i % 40) - 20)::TINYINT END AS ti,
  CASE WHEN i % 31 = 0 THEN NULL ELSE (((i % 40) - 20) * 1000)::SMALLINT END AS si,
  CASE WHEN i % 31 = 0 THEN NULL ELSE (200 + (i % 40))::UTINYINT END AS uti,
  CASE WHEN i % 31 = 0 THEN NULL ELSE (4000000000 + (i % 40))::UINTEGER END AS ui,
  CASE WHEN i % 31 = 0 THEN NULL ELSE ((i % 40) - 20)::BIGINT * 100000000000 END AS bi,
  CASE WHEN i % 31 = 0 THEN NULL ELSE ((i % 40) - 20)::HUGEINT * 100000000000000000000::HUGEINT END AS hu,
  CASE WHEN i % 31 = 0 THEN NULL ELSE TIME '00:00:00' + to_minutes(i % 40) END AS tm,
  CASE WHEN i % 31 = 0 THEN NULL ELSE DATE '1900-01-01' + ((i % 40) * 500)::INTEGER END AS d_wide,
  CASE WHEN i % 31 = 0 THEN NULL ELSE (10000 + (i % 40) * 100000000)::UINTEGER END AS ui_wide,
  CASE WHEN i % 31 = 0 THEN NULL ELSE 9223372036854775808::UBIGINT + (i % 40)::UBIGINT * 100000000000000::UBIGINT END AS u_wide,
  CASE WHEN i % 31 = 0 THEN NULL ELSE 'k' || lpad((i % 40)::VARCHAR, 2, '0') END AS s,
  CASE WHEN i % 31 = 0 THEN NULL ELSE (i % 7)::INTEGER END AS g7
FROM range(60000) t(i)

query I
SELECT count(*) FROM (SELECT d FROM tt GROUP BY d)
----
41

statement ok
CREATE OR REPLACE TABLE f AS SELECT d, count(*) AS n, sum(v) AS s, min(v) AS mn, max(v) AS mx, avg(v) AS av, count(c) AS cc, list_sort(list(v)) AS l FROM tt GROUP BY d

statement ok
CREATE OR REPLACE TABLE r AS SELECT d, count(*) AS n, sum(v) AS s, min(v) AS mn, max(v) AS mx, avg(v) AS av, count(c) AS cc, list_sort(list(v)) AS l, first(v) AS fv, any_value(c) AS ac FROM tt GROUP BY d LIMIT 7

query IIII
SELECT (SELECT count(*) FROM r) = least(7, greatest((SELECT count(*) FROM f) - 0, 0)), (SELECT count(*) FROM (SELECT DISTINCT d FROM r)) = (SELECT count(*) FROM r), (SELECT count(*) FROM r WHERE NOT EXISTS (SELECT 1 FROM f WHERE r.d IS NOT DISTINCT FROM f.d AND r.n IS NOT DISTINCT FROM f.n AND r.s IS NOT DISTINCT FROM f.s AND r.mn IS NOT DISTINCT FROM f.mn AND r.mx IS NOT DISTINCT FROM f.mx AND r.av IS NOT DISTINCT FROM f.av AND r.cc IS NOT DISTINCT FROM f.cc AND r.l IS NOT DISTINCT FROM f.l)), (SELECT count(*) FROM r WHERE NOT EXISTS (SELECT 1 FROM tt WHERE tt.d IS NOT DISTINCT FROM r.d AND tt.v = r.fv)) + (SELECT count(*) FROM r WHERE NOT EXISTS (SELECT 1 FROM tt WHERE tt.d IS NOT DISTINCT FROM r.d AND tt.c IS NOT DISTINCT FROM r.ac))
----
true	true	0	0

