# many groups in a VARCHAR key: the limit is always reached
statement ok
CREATE TABLE t_str_many AS SELECT (i // 3000)::INTEGER::VARCHAR AS k, i AS v FROM range(2000000) t(i)

loop i 0 20

query I
SELECT count(*) FROM (SELECT k, count(*) FROM t_str_many GROUP BY k LIMIT 50)
----
50

endloop


